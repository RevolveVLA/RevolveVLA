diff --git a/gz_ros2_control/src/gz_ros2_control_plugin.cpp b/gz_ros2_control/src/gz_ros2_control_plugin.cpp
index 50feae7..fb5faed 100644
--- a/gz_ros2_control/src/gz_ros2_control_plugin.cpp
+++ b/gz_ros2_control/src/gz_ros2_control_plugin.cpp
@@ -527,6 +527,22 @@ void GazeboSimROS2ControlPlugin::PostUpdate(
     this->dataPtr->controller_manager_->update(sim_time_ros, sim_period);
   }
 }
+
+//////////////////////////////////////////////////
+void GazeboSimROS2ControlPlugin::Reset(
+  const sim::UpdateInfo & _info,
+  sim::EntityComponentManager & /*_ecm*/)
+{
+  // A world reset (e.g. ROS 2 Simulation Interfaces ResetSimulation). Without ISystemReset, gz-sim destroys and
+  // reloads this plugin, and the new controller manager blocks the simulation thread waiting for its hardware.
+  // Keep the controller manager instead and restart the control clock at the reset sim time (it jumps back, so
+  // the update period would stay negative). The hardware re-reads the reset joint states on the next update;
+  // active controllers keep their references, so restart them (controller_manager switch_controller) to latch
+  // onto the reset state.
+  this->dataPtr->last_update_sim_time_ros_ = rclcpp::Time(
+    std::chrono::duration_cast<std::chrono::nanoseconds>(_info.simTime).count(), RCL_ROS_TIME);
+}
+
 }  // namespace gz_ros2_control
 
