<?xml version="1.0"?>
<!-- MoveIt SRDF of mobile_so101_xl: the SO-101 arm's groups, states, end effector and disabled collisions
     (../../common/so101.srdf.xacro), the omni base's rollers (../../common/omni_base.srdf.xacro) and the pairs between
     the arm and the chassis (collisions_updater on this robot). No virtual joint: MoveIt plans in the URDF root,
     base_footprint (the base is driven outside MoveIt). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_so101_xl">
  <xacro:include filename="../../common/so101.srdf.xacro"/>
  <xacro:include filename="../../common/omni_base.srdf.xacro"/>
  <xacro:so101_srdf/>
  <xacro:omni_base_srdf/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
</robot>
