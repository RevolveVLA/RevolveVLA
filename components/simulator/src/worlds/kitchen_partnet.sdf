<?xml version="1.0"?>
<!--
  Articulated kitchen scene (no robot) with the PartNet-Mobility asset set, MuJoCo
  physics: furniture from assets/generated_partnet/
  (asset_pipeline/make_partnet.sh): fridge = PartNet 11211 (one glass door, wire
  racks), kitchen_counter = PartNet 46452 cabinet (live top drawer, door locked).
  table_01 and the primitive cup come from assets/generated/ (make_replicacad.sh).
  scripts/kitchen_test_system.py runs the scripted scene test ($KITCHEN_ASSETS=partnet,
  see scripts/kitchen_assets.py). World name stays "kitchen".

  Layout (room 6 x 6 m, x east, y north, walls west/north/east, floor z = 0):
  - kitchen_counter (0.75 deep, 0.71 wide, 0.90 tall) against the west wall at
    (-2.625, 0.29), front (+x) facing east; drawer bar centre at about
    (-2.236, 0.286, 0.841), drawer travel 0.35 m. Free floor x -2.23 .. -0.7.
  - fridge (0.63 deep, 0.62 wide, 1.75 tall) against the north wall at (-1.5, 2.68),
    front facing south (-y); hinge on its EAST side at about (-1.203, 2.399), so the
    door swings east. Handle bar centre at about
    (-1.787, 2.352, 1.025), clear of its standoffs for z 0.94 .. 1.11.
    Free floor y 2.35 .. 0.85.
  - table_01 (free, 18 kg) at (1.5, -0.5); free floor west and north of it.
  - cup on the upper wire rack (top z 1.1745) at (-1.5, 2.56).
-->
<sdf version="1.11" xmlns:experimental="http://sdformat.org/schemas/experimental">
  <world name="kitchen">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-mujoco-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Scripted scene test (efforts on door/drawer + checks), every 1 ms step -->
    <plugin filename="gz-sim-python-system-loader-system"
            name="gz::sim::systems::PythonSystemLoader">
      <module_name>kitchen_test_system</module_name>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 -0.4 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- Room: wall collisions as before + visual-only shell, decor and fill lights
         (asset_pipeline/make_room.py, built before each kitchen run) -->
    <include>
      <name>walls</name>
      <uri>model://kitchen_room_partnet</uri>
    </include>

    <include>
      <name>kitchen_counter</name>
      <uri>model://kitchen_counter</uri>
      <pose>-2.625 0.29 0 0 0 0</pose>
    </include>

    <include>
      <name>fridge</name>
      <uri>model://fridge</uri>
      <pose>-1.5 2.68 0 0 0 -1.5707963267948966</pose>
    </include>

    <include>
      <name>table_01</name>
      <uri>model://table_01</uri>
      <pose>1.5 -0.5 0.002 0 0 0</pose>
      <!-- contact sensor for the penetration check (scripts/kitchen_test_system.py) -->
      <experimental:params>
        <sensor element_id="table_01" name="contact" type="contact" action="add">
          <update_rate>100</update_rate>
          <contact>
            <collision>table_01_collision_0</collision>
            <collision>table_01_collision_1</collision>
            <collision>table_01_collision_2</collision>
            <collision>table_01_collision_3</collision>
            <collision>table_01_collision_4</collision>
            <collision>table_01_collision_5</collision>
          </contact>
        </sensor>
      </experimental:params>
    </include>

    <!-- Fridge model frame (0.12, 0, 1.1765) = on the upper wire rack whose top is at 1.1745 -->
    <include>
      <name>cup</name>
      <uri>model://cup</uri>
      <pose>-1.5 2.56 1.1765 0 0 0</pose>
      <experimental:params>
        <sensor element_id="cup" name="contact" type="contact" action="add">
          <update_rate>1000</update_rate>
          <contact>
            <collision>cup_collision_0</collision>
            <collision>cup_collision_1</collision>
          </contact>
        </sensor>
      </experimental:params>
    </include>

    <!-- Fixed scene camera, rendered on the GPU; records the MP4 -->
    <model name="scene_camera">
      <static>true</static>
      <pose>1.2 -1.6 2.3 0 0.30 2.37</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <update_rate>30</update_rate>
          <always_on>true</always_on>
          <topic>kitchen_cam/image</topic>
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image><width>1280</width><height>720</height><anti_aliasing>2</anti_aliasing></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
          <plugin filename="gz-sim-camera-video-recorder-system"
                  name="gz::sim::systems::CameraVideoRecorder">
            <service>/kitchen_cam/record_video</service>
            <use_sim_time>true</use_sim_time>
            <fps>30</fps>
            <bitrate>8000000</bitrate>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
