<?xml version="1.0"?>
<package format="3">
  <name>revolve_sim</name>
  <version>0.1.0</version>
  <description>RevolveVLA simulator: the world from a scene spec, the robot from a robot spec, on Gazebo with
    ros_gz and gz_ros2_control.</description>
  <maintainer email="noreply@revolvevla.invalid">RevolveVLA</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>moveit_resources_panda_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>launch_testing</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
