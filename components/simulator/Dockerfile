# revolve-simulator: dependencies only for Gazebo "Kura" (gz-sim 11 / gz-physics 10 main) with the
# MuJoCo physics plugin, the replay / live-validation systems and MCAP bag writing.
# Nothing is built or copied in: `./revolve build simulator` builds Kura from ThirdParty/gz_kura with
# colcon INSIDE this image into ThirdParty/gz_kura/install (git-ignored), mounted at /opt/gz_ws/install
# at runtime (the same path it is built at: gz embeds absolute install paths).
# The source (components/simulator/src, common/), specs/, franka_description and the licence-bound
# assets are mounted too.
# Ported from the earlier pipeline's gz Dockerfile (apt list unchanged, so its layers are reused from the
# build cache) + its bags image (rosbags, pillow). franka_description is not cloned here
# (ThirdParty/franka_description submodule, mounted). The licence-bound assets live in assets/ (git-ignored),
# generated by components/simulator/assets_pipeline (its coacd/trimesh: last layer). No ROS: replay and bag writing
# need none; the policy rollout (evaluation) adds a thin ROS layer FROM this image.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC LANG=C.UTF-8

# --- Base tools + OSRF apt repos (DART, OGRE-Next, Zenoh); vcstool + colcon from pip ---
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg lsb-release git python3-pip python3-venv \
    && curl -fsSL https://packages.osrfoundation.org/gazebo.gpg \
         -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable noble main" \
         > /etc/apt/sources.list.d/gazebo-stable.list \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages vcstool colcon-common-extensions

# --- Build dependencies: union of packages[-noble].apt across the Kura repos ---
RUN apt-get update && apt-get install -y --no-install-recommends \
      binutils-dev build-essential cmake cppzmq-dev freeglut3-dev libassimp-dev \
      libavcodec-dev libavdevice-dev libavformat-dev libavutil-dev libbenchmark-dev \
      libcli11-dev libcurl4-openssl-dev libdart6.16-collision-bullet-dev \
      libdart6.16-collision-ode-dev libdart6.16-dev libdart6.16-external-ikfast-dev \
      libdart6.16-external-odelcpsolver-dev libdart6.16-utils-urdf-dev libdwarf-dev \
      libdw-dev libeigen3-dev libfreeimage-dev libgdal-dev libgflags-dev libgl1-mesa-dev \
      libglew-dev libglu1-mesa-dev libjsoncpp-dev libogre-1.9-dev libogre-next-2.3-dev \
      libprotobuf-dev libprotoc-dev libpython3-dev libqt6svg6 libspdlog-dev \
      libsqlite3-dev libswscale-dev libtinyxml2-dev liburdfdom-dev libvulkan-dev \
      libwebsockets-dev libxi-dev libxml2-utils libxmu-dev libyaml-dev libzenohc-dev \
      libzenohcpp-dev libzip-dev libzmq3-dev mesa-utils pkg-config protobuf-compiler \
      python3-dev python3-numpy python3-protobuf python3-psutil python3-pybind11 \
      python3-pytest python3-yaml qml6-module-qt5compat-graphicaleffects qml6-module-qtcharts \
      qml6-module-qtcore qml6-module-qt-labs-folderlistmodel qml6-module-qt-labs-platform \
      qml6-module-qt-labs-settings qml6-module-qtpositioning qml6-module-qtqml \
      qml6-module-qtqml-models qml6-module-qtqml-workerscript qml6-module-qtquick \
      qml6-module-qtquick-controls qml6-module-qtquick-dialogs qml6-module-qtquick-layouts \
      qml6-module-qtquick-templates qml6-module-qtquick-window qt6-5compat-dev \
      qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
      ruby ruby-dev swig uuid-dev x11-utils xvfb \
      libegl1 libgl1 libglvnd0 libglx0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# --- Compiler cache, kept in ThirdParty/gz_kura/.ccache (git-ignored) ---
RUN apt-get update && apt-get install -y --no-install-recommends ccache \
    && rm -rf /var/lib/apt/lists/*

# --- Python: MCAP bags (rosbags, pure Python) + camera JPEGs (pillow), as the earlier bags image; the
# revolve_common job wrapper and spec loader (pydantic, FastAPI, uvicorn; same pins as the host .venv).
# numpy and PyYAML stay the apt ones (the gz Python bindings are built against apt numpy).
RUN pip3 install --no-cache-dir --break-system-packages \
      rosbags==0.11.9 pillow==11.3.0 \
      pydantic==2.14.3 fastapi==0.162.2 uvicorn==0.54.0 \
    && python3 -c "import rosbags, PIL, pydantic, fastapi, uvicorn, numpy, yaml; print('numpy', numpy.__version__)"

ENV GZ_WS=/opt/gz_ws/install
ENV PATH=${GZ_WS}/bin:${PATH} \
    LD_LIBRARY_PATH=${GZ_WS}/lib \
    PYTHONPATH=${GZ_WS}/lib/python \
    CMAKE_PREFIX_PATH=${GZ_WS} \
    GZ_CONFIG_PATH=${GZ_WS}/share/gz \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    QT_QPA_PLATFORM=xcb \
    PYTHONDONTWRITEBYTECODE=1

RUN echo '[ -f /opt/gz_ws/install/setup.bash ] && source /opt/gz_ws/install/setup.bash' >> /etc/bash.bashrc
WORKDIR /repo
CMD ["bash"]

# --- Asset pipeline (assets_pipeline/): mesh I/O + CoACD convex decomposition (as the legacy gz image) ---
# scipy comes from apt so pip leaves the system numpy alone.
RUN apt-get update && apt-get install -y --no-install-recommends python3-scipy \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages coacd==1.0.14 trimesh==4.11.5 \
    && python3 -c "import coacd, trimesh, numpy; print('numpy', numpy.__version__)"
