<?xml version="1.0"?>
<!-- Simple cup: 6 cm diameter, 9 cm tall, 0.15 kg, origin at the bottom centre.
     The thin square foot (inscribed in the cylinder, 1 mm lower) carries the
     contacts when the cup stands: MuJoCo gives box-box and box-plane pairs
     several contact points, a cylinder on a box only one, which lets it rock. -->
<robot name="cup">
  <link name="cup">
    <inertial>
      <mass value="0.15"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0455"/>
      <geometry><cylinder radius="0.03" length="0.089"/></geometry>
      <material name="ceramic"><color rgba="0.85 0.3 0.25 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.0895"/>
      <geometry><cylinder radius="0.026" length="0.002"/></geometry>
      <material name="inside"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0455"/>
      <geometry><cylinder radius="0.03" length="0.089"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.002"/>
      <geometry><box size="0.042 0.042 0.004"/></geometry>
    </collision>
  </link>
</robot>
